{
  "name": "qualien-mcp",
  "version": "0.5.0",
  "description": "A composite MCP gateway that aggregates multiple MCP servers behind one connection \u2014 curated for SDET/QE workflows.",
  "type": "module",
  "bin": {
    "qualien-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "qualien-mcp.config.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "aggregator",
    "sdet",
    "qa",
    "qe",
    "testing",
    "playwright"
  ],
  "author": "qualien",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qualienai/qualien-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
