{
  "name": "qualien-mcp",
  "version": "0.6.2",
  "mcpName": "io.github.qualienai/qualien-mcp",
  "description": "MCP gateway for QA/SDET work: Playwright, Filesystem, GitHub, Jira, Postgres and more behind one connection.",
  "type": "module",
  "bin": {
    "qualien-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "qualien-mcp.config.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "bundle": "node scripts/bundle.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "gateway",
    "aggregator",
    "sdet",
    "qa",
    "qe",
    "testing",
    "test-automation",
    "qa-automation",
    "playwright",
    "selenium",
    "appium",
    "jira",
    "claude",
    "cursor",
    "ai-agents"
  ],
  "author": "qualien",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qualienai/qualien-mcp.git"
  },
  "homepage": "https://github.com/qualienai/qualien-mcp#readme",
  "bugs": {
    "url": "https://github.com/qualienai/qualien-mcp/issues",
    "email": "contact@qualien.ai"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
